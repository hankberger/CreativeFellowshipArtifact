# ─── Required ───────────────────────────────────────────────────────────────

# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Port the API server listens on.
PORT=3000


# ─── Everything below is optional ───────────────────────────────────────────
# The defaults are correct for local development and for a normal single-domain
# deploy. You do not need to set any of these.

# Images one IP address may generate per hour. Generation is the only route that
# costs money, so this is the ceiling on what abuse can cost you. Default: 12.
# GENERATE_RATE_LIMIT=12

# Signing key for single-use generation tokens. One is generated on first boot
# and kept at data/generation-secret, which is where the database lives, so it
# already survives restarts. Set this only to manage the key yourself.
# GENERATION_SECRET=

# Origins allowed to generate. By default a request is accepted when its Origin
# matches the Host it was sent to. Set this only if the page is served from a
# different domain than the API.
# ALLOWED_ORIGINS=https://your-domain.com

# How to interpret X-Forwarded-For. By default the app trusts it only when the
# connection came from a loopback or private address — i.e. from a reverse proxy
# — which is what Fly, Render, and nginx all do. Set this only if your setup
# puts something unusual in front of the app.
# TRUST_PROXY=1
